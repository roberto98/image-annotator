/**
 * AnnotationRenderer - Renders all annotation types with measurements
 * Uses SVG overlay on top of the image for crisp rendering at all zoom levels
 * @module annotations/renderer
 * 
 * Dependencies:
 * - constants.js (RendererConstants, DefaultColors, Debug)
 */

const AnnotationRenderer = {
    // ========================================================================
    // Properties
    // ========================================================================
    
    /** @type {SVGElement} SVG element for rendering annotations */
    svg: null,
    
    /** @type {HTMLElement} Container element */
    container: null,
    
    /** @type {HTMLElement} Layer for measurement text (HTML for better text rendering) */
    measurementLayer: null,
    
    /** @type {SVGDefsElement} SVG defs for markers and patterns */
    defs: null,
    
    /** @type {Object} Configuration options - initialized from RendererConstants */
    config: null,
    
    /**
     * Get default config from constants or use fallbacks
     * @returns {Object} Default configuration
     */
    _getDefaultConfig() {
        const RC = window.RendererConstants || {};
        return {
            strokeWidth: RC.STROKE_WIDTH ?? 2,
            pointRadius: RC.POINT_RADIUS ?? 6,
            handleRadius: RC.HANDLE_RADIUS ?? 5,
            selectedStrokeWidth: RC.SELECTED_STROKE_WIDTH ?? 3,
            fillOpacity: RC.FILL_OPACITY ?? 0.2,
            selectedFillOpacity: RC.SELECTED_FILL_OPACITY ?? 0.3,
            measurementOffset: RC.MEASUREMENT_OFFSET ?? 15,
            arcRadius: RC.ARC_RADIUS ?? 30,
            showMeasurements: true,
            showHandles: true
        };
    },
    
    // ========================================================================
    // Initialization
    // ========================================================================
    
    /**
     * Initialize the renderer
     * @param {HTMLElement} container - The container to render into
     * @param {Object} [options] - Configuration options
     */
    init(container, options = {}) {
        this.container = container;
        this.config = { ...this._getDefaultConfig(), ...options };
        this.createSVG();
        this.createDefs();
        window.Debug?.log('AnnotationRenderer', 'Initialized');
    },
    
    /**
     * Create SVG overlay element
     */
    createSVG() {
        // Remove existing SVG if present
        if (this.svg) {
            this.svg.remove();
        }
        if (this.measurementLayer) {
            this.measurementLayer.remove();
        }
        
        // Create SVG element
        this.svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        this.svg.classList.add('annotation-svg-layer');
        this.svg.style.cssText = `
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: visible;
            z-index: 10;
        `;
        this.container.appendChild(this.svg);
        
        // Create measurement layer (HTML for better text rendering)
        this.measurementLayer = document.createElement('div');
        this.measurementLayer.className = 'annotation-measurements-layer';
        this.measurementLayer.style.cssText = `
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 11;
        `;
        this.container.appendChild(this.measurementLayer);
    },
    
    /**
     * Create SVG defs for markers, patterns, and gradients
     */
    createDefs() {
        this.defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
        
        // Arrow marker for angle arcs
        const arrowMarker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
        arrowMarker.setAttribute('id', 'arrow-marker');
        arrowMarker.setAttribute('markerWidth', '10');
        arrowMarker.setAttribute('markerHeight', '10');
        arrowMarker.setAttribute('refX', '5');
        arrowMarker.setAttribute('refY', '5');
        arrowMarker.setAttribute('orient', 'auto');
        
        const arrowPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        arrowPath.setAttribute('d', 'M0,0 L10,5 L0,10 z');
        arrowPath.setAttribute('fill', 'currentColor');
        arrowMarker.appendChild(arrowPath);
        this.defs.appendChild(arrowMarker);
        
        this.svg.appendChild(this.defs);
    },
    
    // ========================================================================
    // Main Render Methods
    // ========================================================================
    
    /**
     * Render all annotations
     */
    render() {
        this.clear();
        
        const annotations = window.AnnotationState?.annotations || {};
        const calibration = window.AnnotationState?.calibration?.pixelsPerMm || null;
        
        // Render all saved annotations
        Object.entries(annotations).forEach(([label, annotation]) => {
            // Skip if hidden
            if (window.AnnotationState?.visibilityToggles?.[label] === false) {
                return;
            }
            this.renderAnnotation(label, annotation, calibration);
        });
        
        // Render preview if drawing
        if (window.AnnotationState?.isDrawing && window.AnnotationState?.pendingPoints?.length > 0) {
            this.renderPreview();
        }
    },
    
    /**
     * Clear all rendered annotations
     */
    clear() {
        // Clear SVG content except defs
        const children = Array.from(this.svg.children);
        children.forEach(child => {
            if (child !== this.defs) {
                child.remove();
            }
        });
        
        // Clear measurement layer
        this.measurementLayer.innerHTML = '';
    },
    
    /**
     * Render a single annotation
     * @param {string} label - Annotation label
     * @param {Object} annotation - Annotation data
     * @param {number|null} calibration - Pixels per mm calibration factor
     */
    renderAnnotation(label, annotation, calibration) {
        const type = annotation.type;
        const data = annotation.data || annotation;
        const color = annotation.color || this.getDefaultColor(type);
        // Check both selectedAnnotation (object) and selectedLabel (string) for compatibility
        const isSelected = label === window.AnnotationState?.selectedAnnotation || 
                          label === window.AnnotationState?.selectedLabel;
        
        // Dispatch table for annotation types
        const renderers = {
            'point': () => this.renderPoint(label, data, color, isSelected),
            'line': () => this.renderLine(label, data, color, isSelected, calibration),
            'circle': () => this.renderCircle(label, data, color, isSelected, calibration),
            'rectangle': () => this.renderRectangle(label, data, color, isSelected, calibration),
            'angle': () => this.renderAngle(label, data, color, isSelected),
            'polygon': () => this.renderPolygon(label, data, color, isSelected, calibration),
            'freehand': () => this.renderFreehand(label, data, color, isSelected)
        };
        
        const renderer = renderers[type];
        if (renderer) {
            renderer();
        } else if (annotation.coordinates) {
            // Handle legacy point annotations (coordinates directly on annotation)
            this.renderPoint(label, annotation.coordinates, color, isSelected);
        } else {
            // Unknown type - log warning for debugging
            window.Debug?.warn('AnnotationRenderer', `Unknown annotation type: ${type} for label: ${label}`);
        }
    },
    
    /**
     * Get default color for annotation type
     * @param {string} type - Annotation type
     * @returns {string} Hex color
     */
    getDefaultColor(type) {
        const colors = window.DefaultColors || {
            'point': '#ff0000',
            'line': '#0066ff',
            'circle': '#ffaa00',
            'rectangle': '#9933ff',
            'angle': '#00cccc',
            'polygon': '#00cc66',
            'freehand': '#ff6600',
            'fallback': '#ff0000'
        };
        return colors[type] || colors.fallback || '#ff0000';
    },
    
    // ========================================================================
    // Coordinate Conversion Helpers
    // ========================================================================
    
    /**
     * Convert image coordinates to display coordinates
     * @param {number} x - Image X coordinate
     * @param {number} y - Image Y coordinate
     * @returns {{x: number, y: number}} Display coordinates
     */
    toDisplay(x, y) {
        if (window.viewport) {
            return window.viewport.imageToDisplay(x, y);
        }
        // Fallback if viewport not available
        const zoom = window.STATE?.currentZoom || 1;
        const tx = window.STATE?.translateX || 0;
        const ty = window.STATE?.translateY || 0;
        return {
            x: x * zoom + tx,
            y: y * zoom + ty
        };
    },
    
    /**
     * Get current zoom level
     * @returns {number} Zoom level
     */
    getZoom() {
        return window.viewport?.zoom || window.STATE?.currentZoom || 1;
    },
    
    // ========================================================================
    // SVG Element Creation Helpers
    // ========================================================================
    
    /**
     * Create an SVG group element with accessibility attributes
     * @param {string} className - CSS class name
     * @param {string} label - Data label attribute (also used for ARIA)
     * @param {string} [annotationType] - Type of annotation for ARIA description
     * @returns {SVGGElement}
     */
    createGroup(className, label, annotationType = null) {
        const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        group.classList.add(className);
        if (label) {
            group.dataset.label = label;
            group.dataset.annotation = label; // For EditingHandler compatibility
            
            // Add ARIA attributes for accessibility
            group.setAttribute('role', 'img');
            const ariaLabel = annotationType 
                ? `${annotationType} annotation: ${label}`
                : `Annotation: ${label}`;
            group.setAttribute('aria-label', ariaLabel);
        }
        return group;
    },
    
    /**
     * Create an SVG circle element
     * @param {number} cx - Center X
     * @param {number} cy - Center Y
     * @param {number} r - Radius
     * @param {Object} attrs - Additional attributes
     * @returns {SVGCircleElement}
     */
    createCircle(cx, cy, r, attrs = {}) {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', cx);
        circle.setAttribute('cy', cy);
        circle.setAttribute('r', r);
        Object.entries(attrs).forEach(([key, value]) => {
            circle.setAttribute(key, value);
        });
        return circle;
    },
    
    /**
     * Create an SVG line element
     * @param {number} x1 - Start X
     * @param {number} y1 - Start Y
     * @param {number} x2 - End X
     * @param {number} y2 - End Y
     * @param {Object} attrs - Additional attributes
     * @returns {SVGLineElement}
     */
    createLine(x1, y1, x2, y2, attrs = {}) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', x1);
        line.setAttribute('y1', y1);
        line.setAttribute('x2', x2);
        line.setAttribute('y2', y2);
        Object.entries(attrs).forEach(([key, value]) => {
            line.setAttribute(key, value);
        });
        return line;
    },
    
    /**
     * Create an SVG rectangle element
     * @param {number} x - Top-left X
     * @param {number} y - Top-left Y
     * @param {number} width - Width
     * @param {number} height - Height
     * @param {Object} attrs - Additional attributes
     * @returns {SVGRectElement}
     */
    createRect(x, y, width, height, attrs = {}) {
        const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', x);
        rect.setAttribute('y', y);
        rect.setAttribute('width', width);
        rect.setAttribute('height', height);
        Object.entries(attrs).forEach(([key, value]) => {
            rect.setAttribute(key, value);
        });
        return rect;
    },
    
    /**
     * Create an SVG path element
     * @param {string} d - Path data
     * @param {Object} attrs - Additional attributes
     * @returns {SVGPathElement}
     */
    createPath(d, attrs = {}) {
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d);
        Object.entries(attrs).forEach(([key, value]) => {
            path.setAttribute(key, value);
        });
        return path;
    },
    
    /**
     * Create an SVG text element
     * @param {number} x - X position
     * @param {number} y - Y position
     * @param {string} text - Text content
     * @param {Object} attrs - Additional attributes
     * @returns {SVGTextElement}
     */
    createText(x, y, text, attrs = {}) {
        const textEl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textEl.setAttribute('x', x);
        textEl.setAttribute('y', y);
        textEl.textContent = text;
        Object.entries(attrs).forEach(([key, value]) => {
            textEl.setAttribute(key, value);
        });
        return textEl;
    },
    
    /**
     * Create an interactive handle element
     * @param {number} x - X position
     * @param {number} y - Y position
     * @param {string} handleType - Type of handle (e.g., 'start', 'end', 'vertex')
     * @param {string} color - Handle color
     * @param {string} [label] - Annotation label for this handle
     * @returns {SVGCircleElement}
     */
    createHandle(x, y, handleType, color, label = null) {
        const handle = this.createCircle(x, y, this.config.handleRadius, {
            'class': `annotation-handle handle-${handleType}`,
            'fill': '#ffffff',
            'stroke': color,
            'stroke-width': '2',
            'style': 'pointer-events: all; cursor: move;'
        });
        handle.dataset.handleType = handleType;
        handle.dataset.handle = handleType; // For EditingHandler compatibility
        if (label) {
            handle.dataset.annotation = label; // For EditingHandler compatibility
            handle.dataset.label = label;
        }
        return handle;
    },
    
    /**
     * Create a measurement label in the HTML layer
     * @param {number} x - X position
     * @param {number} y - Y position
     * @param {string} text - Measurement text
     * @param {string} color - Text color
     * @param {string} [className] - Additional CSS class
     * @returns {HTMLElement}
     */
    createMeasurementLabel(x, y, text, color, className = '') {
        const label = document.createElement('div');
        label.className = `annotation-measurement ${className}`.trim();
        label.style.cssText = `
            position: absolute;
            left: ${x}px;
            top: ${y}px;
            color: ${color};
            transform: translate(-50%, -100%);
        `;
        label.textContent = text;
        return label;
    },
    
    /**
     * Create an annotation label
     * @param {number} x - X position
     * @param {number} y - Y position
     * @param {string} text - Label text
     * @param {string} color - Label color
     * @returns {HTMLElement}
     */
    createLabel(x, y, text, color) {
        const label = document.createElement('div');
        label.className = 'annotation-label-tag';
        label.style.cssText = `
            position: absolute;
            left: ${x}px;
            top: ${y}px;
            background: ${color};
            color: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 500;
            white-space: nowrap;
            transform: translate(8px, -50%);
            pointer-events: none;
        `;
        label.textContent = text;
        return label;
    },
    
    // ========================================================================
    // Point Rendering
    // ========================================================================
    
    /**
     * Render a point annotation with cross marker
     * @param {string} label - Annotation label
     * @param {Object} data - Point data {x, y}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     */
    renderPoint(label, data, color, isSelected) {
        const pos = this.toDisplay(data.x, data.y);
        const group = this.createGroup('annotation-point-group', label, 'point');
        if (isSelected) group.classList.add('selected');
        
        const r = this.config.pointRadius;
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        
        // Outer circle
        const outerCircle = this.createCircle(pos.x, pos.y, r, {
            'class': 'annotation-point-outer',
            'fill': 'none',
            'stroke': color,
            'stroke-width': strokeWidth
        });
        group.appendChild(outerCircle);
        
        // Inner fill
        const innerCircle = this.createCircle(pos.x, pos.y, r - 2, {
            'class': 'annotation-point-inner',
            'fill': color,
            'fill-opacity': '0.3'
        });
        group.appendChild(innerCircle);
        
        // Cross marker
        const crossSize = r + 2;
        const crossAttrs = {
            'class': 'annotation-point-cross',
            'stroke': color,
            'stroke-width': strokeWidth
        };
        
        // Horizontal line
        group.appendChild(this.createLine(
            pos.x - crossSize, pos.y,
            pos.x + crossSize, pos.y,
            crossAttrs
        ));
        
        // Vertical line
        group.appendChild(this.createLine(
            pos.x, pos.y - crossSize,
            pos.x, pos.y + crossSize,
            crossAttrs
        ));
        
        // Interactive handle for editing
        if (this.config.showHandles && isSelected) {
            const handle = this.createHandle(pos.x, pos.y, 'center', color, label);
            group.appendChild(handle);
        }
        
        this.svg.appendChild(group);
        
        // Add label
        const labelEl = this.createLabel(pos.x + r, pos.y, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Line Rendering
    // ========================================================================
    
    /**
     * Render a line annotation with endpoints and length text
     * @param {string} label - Annotation label
     * @param {Object} data - Line data {start: {x, y}, end: {x, y}}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     * @param {number|null} calibration - Pixels per mm
     */
    renderLine(label, data, color, isSelected, calibration) {
        const start = this.toDisplay(data.start.x, data.start.y);
        const end = this.toDisplay(data.end.x, data.end.y);
        
        const group = this.createGroup('annotation-line-group', label, 'line');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        
        // Main line
        const line = this.createLine(start.x, start.y, end.x, end.y, {
            'class': 'annotation-line',
            'stroke': color,
            'stroke-width': strokeWidth,
            'stroke-linecap': 'round'
        });
        group.appendChild(line);
        
        // Endpoint markers
        const endpointRadius = 4;
        group.appendChild(this.createCircle(start.x, start.y, endpointRadius, {
            'class': 'annotation-line-endpoint',
            'fill': color
        }));
        group.appendChild(this.createCircle(end.x, end.y, endpointRadius, {
            'class': 'annotation-line-endpoint',
            'fill': color
        }));
        
        // Interactive handles for editing
        if (this.config.showHandles && isSelected) {
            const startHandle = this.createHandle(start.x, start.y, 'start', color, label);
            startHandle.dataset.pointIndex = '0';
            group.appendChild(startHandle);
            
            const endHandle = this.createHandle(end.x, end.y, 'end', color, label);
            endHandle.dataset.pointIndex = '1';
            group.appendChild(endHandle);
        }
        
        this.svg.appendChild(group);
        
        // Calculate and display measurement
        if (this.config.showMeasurements && window.Measurements) {
            const measurements = window.Measurements.measureLine(data, calibration);
            const midX = (start.x + end.x) / 2;
            const midY = (start.y + end.y) / 2;
            
            // Calculate perpendicular offset for label placement
            const angle = Math.atan2(end.y - start.y, end.x - start.x);
            const offsetX = Math.sin(angle) * this.config.measurementOffset;
            const offsetY = -Math.cos(angle) * this.config.measurementOffset;
            
            const measurementLabel = this.createMeasurementLabel(
                midX + offsetX,
                midY + offsetY,
                measurements.formatted.length,
                color,
                'measurement-length'
            );
            this.measurementLayer.appendChild(measurementLabel);
        }
        
        // Add annotation label near start point
        const labelEl = this.createLabel(start.x, start.y - 10, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Circle Rendering
    // ========================================================================
    
    /**
     * Render a circle annotation with center point, radius line, and radius text
     * @param {string} label - Annotation label
     * @param {Object} data - Circle data {center: {x, y}, radius: number}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     * @param {number|null} calibration - Pixels per mm
     */
    renderCircle(label, data, color, isSelected, calibration) {
        const center = this.toDisplay(data.center.x, data.center.y);
        const zoom = this.getZoom();
        const displayRadius = data.radius * zoom;
        
        const group = this.createGroup('annotation-circle-group', label, 'circle');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        const fillOpacity = isSelected ? this.config.selectedFillOpacity : this.config.fillOpacity;
        
        // Circle outline
        const circle = this.createCircle(center.x, center.y, displayRadius, {
            'class': 'annotation-circle',
            'fill': color,
            'fill-opacity': fillOpacity,
            'stroke': color,
            'stroke-width': strokeWidth
        });
        group.appendChild(circle);
        
        // Center point marker
        const centerMarker = this.createCircle(center.x, center.y, 3, {
            'class': 'annotation-circle-center',
            'fill': color
        });
        group.appendChild(centerMarker);
        
        // Radius line (horizontal from center)
        const radiusLine = this.createLine(
            center.x, center.y,
            center.x + displayRadius, center.y,
            {
                'class': 'annotation-circle-radius-line',
                'stroke': color,
                'stroke-width': '1',
                'stroke-dasharray': '4,2'
            }
        );
        group.appendChild(radiusLine);
        
        // Interactive handles for editing
        if (this.config.showHandles && isSelected) {
            // Center handle
            const centerHandle = this.createHandle(center.x, center.y, 'center', color, label);
            group.appendChild(centerHandle);
            
            // Radius handle (on the right edge)
            const radiusHandle = this.createHandle(center.x + displayRadius, center.y, 'radius', color, label);
            group.appendChild(radiusHandle);
            
            // Additional handles at cardinal points
            ['top', 'bottom', 'left'].forEach((pos, i) => {
                let hx = center.x, hy = center.y;
                if (pos === 'top') hy -= displayRadius;
                else if (pos === 'bottom') hy += displayRadius;
                else if (pos === 'left') hx -= displayRadius;
                
                const handle = this.createHandle(hx, hy, `radius-${pos}`, color, label);
                group.appendChild(handle);
            });
        }
        
        this.svg.appendChild(group);
        
        // Calculate and display measurement
        if (this.config.showMeasurements && window.Measurements) {
            const measurements = window.Measurements.measureCircle(data, calibration);
            
            // Radius text along the radius line
            const radiusMidX = center.x + displayRadius / 2;
            const radiusMidY = center.y - 8;
            
            const radiusLabel = this.createMeasurementLabel(
                radiusMidX, radiusMidY,
                `r: ${measurements.formatted.radius}`,
                color,
                'measurement-radius'
            );
            this.measurementLayer.appendChild(radiusLabel);
            
            // Area text inside circle
            if (displayRadius > 40) {
                const areaLabel = this.createMeasurementLabel(
                    center.x,
                    center.y + 15,
                    `A: ${measurements.formatted.area}`,
                    color,
                    'measurement-area'
                );
                areaLabel.style.transform = 'translate(-50%, 0)';
                this.measurementLayer.appendChild(areaLabel);
            }
        }
        
        // Add annotation label
        const labelEl = this.createLabel(center.x + displayRadius, center.y, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Rectangle Rendering
    // ========================================================================
    
    /**
     * Render a rectangle annotation with corner points and dimensions text
     * @param {string} label - Annotation label
     * @param {Object} data - Rectangle data {topLeft: {x, y}, bottomRight: {x, y}}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     * @param {number|null} calibration - Pixels per mm
     */
    renderRectangle(label, data, color, isSelected, calibration) {
        // Handle both formats
        let topLeft, bottomRight;
        if (data.topLeft && data.bottomRight) {
            topLeft = this.toDisplay(data.topLeft.x, data.topLeft.y);
            bottomRight = this.toDisplay(data.bottomRight.x, data.bottomRight.y);
        } else if (data.center && data.width && data.height) {
            const zoom = this.getZoom();
            const center = this.toDisplay(data.center.x, data.center.y);
            const halfW = (data.width * zoom) / 2;
            const halfH = (data.height * zoom) / 2;
            topLeft = { x: center.x - halfW, y: center.y - halfH };
            bottomRight = { x: center.x + halfW, y: center.y + halfH };
        } else {
            return; // Invalid data
        }
        
        // Normalize coordinates (ensure topLeft is actually top-left)
        const x = Math.min(topLeft.x, bottomRight.x);
        const y = Math.min(topLeft.y, bottomRight.y);
        const width = Math.abs(bottomRight.x - topLeft.x);
        const height = Math.abs(bottomRight.y - topLeft.y);
        
        const group = this.createGroup('annotation-rectangle-group', label, 'rectangle');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        const fillOpacity = isSelected ? this.config.selectedFillOpacity : this.config.fillOpacity;
        
        // Rectangle
        const rect = this.createRect(x, y, width, height, {
            'class': 'annotation-rectangle',
            'fill': color,
            'fill-opacity': fillOpacity,
            'stroke': color,
            'stroke-width': strokeWidth
        });
        group.appendChild(rect);
        
        // Corner markers
        const corners = [
            { x: x, y: y, type: 'nw' },
            { x: x + width, y: y, type: 'ne' },
            { x: x, y: y + height, type: 'sw' },
            { x: x + width, y: y + height, type: 'se' }
        ];
        
        corners.forEach(corner => {
            const marker = this.createCircle(corner.x, corner.y, 3, {
                'class': 'annotation-rectangle-corner',
                'fill': color
            });
            group.appendChild(marker);
            
            // Interactive handles for editing
            if (this.config.showHandles && isSelected) {
                const handle = this.createHandle(corner.x, corner.y, corner.type, color, label);
                group.appendChild(handle);
            }
        });
        
        // Edge midpoint handles for resizing
        if (this.config.showHandles && isSelected) {
            const edges = [
                { x: x + width / 2, y: y, type: 'n' },
                { x: x + width / 2, y: y + height, type: 's' },
                { x: x, y: y + height / 2, type: 'w' },
                { x: x + width, y: y + height / 2, type: 'e' }
            ];
            
            edges.forEach(edge => {
                const handle = this.createHandle(edge.x, edge.y, edge.type, color, label);
                group.appendChild(handle);
            });
        }
        
        this.svg.appendChild(group);
        
        // Calculate and display measurements
        if (this.config.showMeasurements && window.Measurements) {
            const measurements = window.Measurements.measureRectangle(data, calibration);
            
            // Width label (top)
            const widthLabel = this.createMeasurementLabel(
                x + width / 2,
                y - 5,
                measurements.formatted.width,
                color,
                'measurement-width'
            );
            this.measurementLayer.appendChild(widthLabel);
            
            // Height label (right side)
            const heightLabel = this.createMeasurementLabel(
                x + width + 10,
                y + height / 2,
                measurements.formatted.height,
                color,
                'measurement-height'
            );
            heightLabel.style.transform = 'translate(0, -50%)';
            this.measurementLayer.appendChild(heightLabel);
            
            // Area label (center, if large enough)
            if (width > 60 && height > 40) {
                const areaLabel = this.createMeasurementLabel(
                    x + width / 2,
                    y + height / 2,
                    `A: ${measurements.formatted.area}`,
                    color,
                    'measurement-area'
                );
                areaLabel.style.transform = 'translate(-50%, -50%)';
                this.measurementLayer.appendChild(areaLabel);
            }
        }
        
        // Add annotation label
        const labelEl = this.createLabel(x, y - 5, label, color);
        labelEl.style.transform = 'translate(0, -100%)';
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Angle Rendering
    // ========================================================================
    
    /**
     * Render an angle annotation with two lines from vertex and arc showing angle
     * @param {string} label - Annotation label
     * @param {Object} data - Angle data {point1: {x, y}, vertex: {x, y}, point2: {x, y}}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     */
    renderAngle(label, data, color, isSelected) {
        const p1 = this.toDisplay(data.point1.x, data.point1.y);
        const vertex = this.toDisplay(data.vertex.x, data.vertex.y);
        const p2 = this.toDisplay(data.point2.x, data.point2.y);
        
        const group = this.createGroup('annotation-angle-group', label, 'angle');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        
        // Arm 1: vertex to point1
        const arm1 = this.createLine(vertex.x, vertex.y, p1.x, p1.y, {
            'class': 'annotation-angle-arm',
            'stroke': color,
            'stroke-width': strokeWidth,
            'stroke-linecap': 'round'
        });
        group.appendChild(arm1);
        
        // Arm 2: vertex to point2
        const arm2 = this.createLine(vertex.x, vertex.y, p2.x, p2.y, {
            'class': 'annotation-angle-arm',
            'stroke': color,
            'stroke-width': strokeWidth,
            'stroke-linecap': 'round'
        });
        group.appendChild(arm2);
        
        // Calculate angles for arc
        const angle1 = Math.atan2(p1.y - vertex.y, p1.x - vertex.x);
        const angle2 = Math.atan2(p2.y - vertex.y, p2.x - vertex.x);
        
        // Determine if we should draw the arc the "short way"
        let startAngle = angle1;
        let endAngle = angle2;
        let sweepFlag = 0;
        
        // Calculate the angle difference
        let diff = endAngle - startAngle;
        while (diff < -Math.PI) diff += 2 * Math.PI;
        while (diff > Math.PI) diff -= 2 * Math.PI;
        
        if (diff < 0) {
            sweepFlag = 0;
        } else {
            sweepFlag = 1;
        }
        
        // Arc radius
        const arcRadius = Math.min(this.config.arcRadius, 
            Math.sqrt((p1.x - vertex.x) ** 2 + (p1.y - vertex.y) ** 2) * 0.4,
            Math.sqrt((p2.x - vertex.x) ** 2 + (p2.y - vertex.y) ** 2) * 0.4
        );
        
        // Arc endpoints
        const arcStart = {
            x: vertex.x + arcRadius * Math.cos(startAngle),
            y: vertex.y + arcRadius * Math.sin(startAngle)
        };
        const arcEnd = {
            x: vertex.x + arcRadius * Math.cos(endAngle),
            y: vertex.y + arcRadius * Math.sin(endAngle)
        };
        
        // Create arc path
        const largeArcFlag = Math.abs(diff) > Math.PI ? 1 : 0;
        const arcPath = `M ${arcStart.x} ${arcStart.y} A ${arcRadius} ${arcRadius} 0 ${largeArcFlag} ${sweepFlag} ${arcEnd.x} ${arcEnd.y}`;
        
        const arc = this.createPath(arcPath, {
            'class': 'annotation-angle-arc',
            'fill': 'none',
            'stroke': color,
            'stroke-width': strokeWidth - 0.5
        });
        group.appendChild(arc);
        
        // Vertex marker
        const vertexMarker = this.createCircle(vertex.x, vertex.y, 4, {
            'class': 'annotation-angle-vertex',
            'fill': color
        });
        group.appendChild(vertexMarker);
        
        // Endpoint markers
        group.appendChild(this.createCircle(p1.x, p1.y, 3, {
            'class': 'annotation-angle-endpoint',
            'fill': color
        }));
        group.appendChild(this.createCircle(p2.x, p2.y, 3, {
            'class': 'annotation-angle-endpoint',
            'fill': color
        }));
        
        // Interactive handles for editing
        if (this.config.showHandles && isSelected) {
            const point1Handle = this.createHandle(p1.x, p1.y, 'point1', color, label);
            point1Handle.dataset.pointIndex = '0';
            group.appendChild(point1Handle);
            
            const vertexHandle = this.createHandle(vertex.x, vertex.y, 'vertex', color, label);
            vertexHandle.dataset.pointIndex = '1';
            group.appendChild(vertexHandle);
            
            const point2Handle = this.createHandle(p2.x, p2.y, 'point2', color, label);
            point2Handle.dataset.pointIndex = '2';
            group.appendChild(point2Handle);
        }
        
        this.svg.appendChild(group);
        
        // Calculate and display angle measurement
        if (this.config.showMeasurements && window.Measurements) {
            const measurements = window.Measurements.measureAngle(data);
            
            // Position angle text along the arc bisector
            const bisectorAngle = (startAngle + endAngle) / 2;
            // Adjust if we went the "long way"
            const textRadius = arcRadius + 15;
            const textX = vertex.x + textRadius * Math.cos(bisectorAngle);
            const textY = vertex.y + textRadius * Math.sin(bisectorAngle);
            
            const angleLabel = this.createMeasurementLabel(
                textX, textY,
                measurements.formatted.angle,
                color,
                'measurement-angle'
            );
            angleLabel.style.transform = 'translate(-50%, -50%)';
            this.measurementLayer.appendChild(angleLabel);
        }
        
        // Add annotation label
        const labelEl = this.createLabel(vertex.x, vertex.y - 20, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Polygon Rendering
    // ========================================================================
    
    /**
     * Render a polygon annotation with vertices
     * @param {string} label - Annotation label
     * @param {Object} data - Polygon data {points: [{x, y}, ...]}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     * @param {number|null} calibration - Pixels per mm
     */
    renderPolygon(label, data, color, isSelected, calibration) {
        const points = data.points || [];
        if (points.length < 3) return;
        
        const displayPoints = points.map(p => this.toDisplay(p.x, p.y));
        
        const group = this.createGroup('annotation-polygon-group', label, 'polygon');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        const fillOpacity = isSelected ? this.config.selectedFillOpacity : this.config.fillOpacity;
        
        // Create polygon path
        const pathData = displayPoints.map((p, i) => 
            `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`
        ).join(' ') + ' Z';
        
        const polygon = this.createPath(pathData, {
            'class': 'annotation-polygon',
            'fill': color,
            'fill-opacity': fillOpacity,
            'stroke': color,
            'stroke-width': strokeWidth,
            'stroke-linejoin': 'round'
        });
        group.appendChild(polygon);
        
        // Vertex markers and handles
        displayPoints.forEach((p, index) => {
            // Vertex marker
            const marker = this.createCircle(p.x, p.y, 3, {
                'class': 'annotation-polygon-vertex',
                'fill': color
            });
            group.appendChild(marker);
            
            // Interactive handles for editing
            if (this.config.showHandles && isSelected) {
                const handle = this.createHandle(p.x, p.y, `vertex-${index}`, color, label);
                handle.dataset.pointIndex = index.toString();
                group.appendChild(handle);
            }
        });
        
        this.svg.appendChild(group);
        
        // Calculate and display measurements
        if (this.config.showMeasurements && window.Measurements) {
            const measurements = window.Measurements.measurePolygon(data, calibration);
            const centroid = this.toDisplay(measurements.centroid.x, measurements.centroid.y);
            
            // Area label at centroid
            const areaLabel = this.createMeasurementLabel(
                centroid.x,
                centroid.y,
                `A: ${measurements.formatted.area}`,
                color,
                'measurement-area'
            );
            areaLabel.style.transform = 'translate(-50%, -50%)';
            this.measurementLayer.appendChild(areaLabel);
            
            // Perimeter label below area
            const perimeterLabel = this.createMeasurementLabel(
                centroid.x,
                centroid.y + 18,
                `P: ${measurements.formatted.perimeter}`,
                color,
                'measurement-perimeter'
            );
            perimeterLabel.style.transform = 'translate(-50%, -50%)';
            this.measurementLayer.appendChild(perimeterLabel);
        }
        
        // Add annotation label near first vertex
        const labelEl = this.createLabel(displayPoints[0].x, displayPoints[0].y - 10, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Freehand Rendering
    // ========================================================================
    
    /**
     * Render a freehand annotation following all points
     * @param {string} label - Annotation label
     * @param {Object} data - Freehand data {points: [{x, y}, ...]}
     * @param {string} color - Display color
     * @param {boolean} isSelected - Whether annotation is selected
     */
    renderFreehand(label, data, color, isSelected) {
        const points = data.points || [];
        if (points.length < 2) return;
        
        const displayPoints = points.map(p => this.toDisplay(p.x, p.y));
        
        const group = this.createGroup('annotation-freehand-group', label, 'freehand');
        if (isSelected) group.classList.add('selected');
        
        const strokeWidth = isSelected ? this.config.selectedStrokeWidth : this.config.strokeWidth;
        
        // Create smooth path using quadratic curves for smoother appearance
        let pathData = `M ${displayPoints[0].x} ${displayPoints[0].y}`;
        
        if (displayPoints.length === 2) {
            pathData += ` L ${displayPoints[1].x} ${displayPoints[1].y}`;
        } else {
            // Use quadratic curves for smoothing
            for (let i = 1; i < displayPoints.length - 1; i++) {
                const xc = (displayPoints[i].x + displayPoints[i + 1].x) / 2;
                const yc = (displayPoints[i].y + displayPoints[i + 1].y) / 2;
                pathData += ` Q ${displayPoints[i].x} ${displayPoints[i].y} ${xc} ${yc}`;
            }
            // Final point
            const last = displayPoints[displayPoints.length - 1];
            pathData += ` L ${last.x} ${last.y}`;
        }
        
        const freehandPath = this.createPath(pathData, {
            'class': 'annotation-freehand',
            'fill': 'none',
            'stroke': color,
            'stroke-width': strokeWidth,
            'stroke-linecap': 'round',
            'stroke-linejoin': 'round'
        });
        group.appendChild(freehandPath);
        
        // Start and end markers
        const startMarker = this.createCircle(displayPoints[0].x, displayPoints[0].y, 4, {
            'class': 'annotation-freehand-start',
            'fill': color
        });
        group.appendChild(startMarker);
        
        const endMarker = this.createCircle(
            displayPoints[displayPoints.length - 1].x,
            displayPoints[displayPoints.length - 1].y,
            4,
            {
                'class': 'annotation-freehand-end',
                'fill': 'white',
                'stroke': color,
                'stroke-width': '2'
            }
        );
        group.appendChild(endMarker);
        
        this.svg.appendChild(group);
        
        // Add annotation label near start point
        const labelEl = this.createLabel(displayPoints[0].x, displayPoints[0].y - 10, label, color);
        this.measurementLayer.appendChild(labelEl);
    },
    
    // ========================================================================
    // Preview Rendering (In-Progress Drawing)
    // ========================================================================
    
    /**
     * Render preview of annotation being drawn
     */
    renderPreview() {
        const state = window.AnnotationState;
        if (!state?.pendingPoints?.length) return;
        
        const type = state.pendingType;
        const points = state.pendingPoints;
        const color = '#666666'; // Preview color
        
        const group = this.createGroup('annotation-preview', '');
        group.style.opacity = '0.7';
        
        // Dispatch table for preview renderers
        const previewRenderers = {
            'point': () => this.renderPointPreview(group, points, color),
            'line': () => this.renderLinePreview(group, points, color),
            'circle': () => this.renderCirclePreview(group, points, color),
            'rectangle': () => this.renderRectanglePreview(group, points, color),
            'angle': () => this.renderAnglePreview(group, points, color),
            'polygon': () => this.renderPolygonPreview(group, points, color),
            'freehand': () => this.renderFreehandPreview(group, points, color)
        };
        
        const renderer = previewRenderers[type];
        if (renderer) {
            renderer();
        } else {
            // Unknown preview type - log warning for debugging
            window.Debug?.warn('AnnotationRenderer', `Unknown preview type: ${type}`);
        }
        
        this.svg.appendChild(group);
    },
    
    /**
     * Render point preview
     */
    renderPointPreview(group, points, color) {
        if (points.length < 1) return;
        const pos = this.toDisplay(points[0].x, points[0].y);
        
        const r = this.config.pointRadius;
        group.appendChild(this.createCircle(pos.x, pos.y, r, {
            'fill': 'none',
            'stroke': color,
            'stroke-width': '2',
            'stroke-dasharray': '4,2'
        }));
        
        // Cross
        const crossSize = r + 2;
        group.appendChild(this.createLine(
            pos.x - crossSize, pos.y,
            pos.x + crossSize, pos.y,
            { 'stroke': color, 'stroke-width': '2', 'stroke-dasharray': '4,2' }
        ));
        group.appendChild(this.createLine(
            pos.x, pos.y - crossSize,
            pos.x, pos.y + crossSize,
            { 'stroke': color, 'stroke-width': '2', 'stroke-dasharray': '4,2' }
        ));
    },
    
    /**
     * Render line preview
     */
    renderLinePreview(group, points, color) {
        if (points.length < 1) return;
        
        const start = this.toDisplay(points[0].x, points[0].y);
        group.appendChild(this.createCircle(start.x, start.y, 4, {
            'fill': color
        }));
        
        if (points.length >= 2) {
            const end = this.toDisplay(points[1].x, points[1].y);
            group.appendChild(this.createLine(start.x, start.y, end.x, end.y, {
                'stroke': color,
                'stroke-width': '2',
                'stroke-dasharray': '6,3'
            }));
            group.appendChild(this.createCircle(end.x, end.y, 4, {
                'fill': color
            }));
            
            // Show length preview
            if (window.Measurements) {
                const length = window.Measurements.lineLength(points[0], points[1]);
                const midX = (start.x + end.x) / 2;
                const midY = (start.y + end.y) / 2 - 10;
                
                const label = this.createMeasurementLabel(midX, midY, `${length.toFixed(1)}px`, color);
                label.classList.add('preview-measurement');
                this.measurementLayer.appendChild(label);
            }
        }
    },
    
    /**
     * Render circle preview
     */
    renderCirclePreview(group, points, color) {
        if (points.length < 1) return;
        
        const center = this.toDisplay(points[0].x, points[0].y);
        group.appendChild(this.createCircle(center.x, center.y, 3, {
            'fill': color
        }));
        
        if (points.length >= 2) {
            const edge = this.toDisplay(points[1].x, points[1].y);
            const radius = Math.sqrt((edge.x - center.x) ** 2 + (edge.y - center.y) ** 2);
            
            group.appendChild(this.createCircle(center.x, center.y, radius, {
                'fill': 'none',
                'stroke': color,
                'stroke-width': '2',
                'stroke-dasharray': '6,3'
            }));
            
            // Radius line
            group.appendChild(this.createLine(center.x, center.y, edge.x, edge.y, {
                'stroke': color,
                'stroke-width': '1',
                'stroke-dasharray': '4,2'
            }));
            
            // Show radius preview
            if (window.Measurements) {
                const radiusPx = window.Measurements.lineLength(points[0], points[1]);
                const label = this.createMeasurementLabel(
                    center.x + radius / 2, center.y - 8,
                    `r: ${radiusPx.toFixed(1)}px`, color
                );
                label.classList.add('preview-measurement');
                this.measurementLayer.appendChild(label);
            }
        }
    },
    
    /**
     * Render rectangle preview
     */
    renderRectanglePreview(group, points, color) {
        if (points.length < 1) return;
        
        const p1 = this.toDisplay(points[0].x, points[0].y);
        group.appendChild(this.createCircle(p1.x, p1.y, 3, {
            'fill': color
        }));
        
        if (points.length >= 2) {
            const p2 = this.toDisplay(points[1].x, points[1].y);
            const x = Math.min(p1.x, p2.x);
            const y = Math.min(p1.y, p2.y);
            const width = Math.abs(p2.x - p1.x);
            const height = Math.abs(p2.y - p1.y);
            
            group.appendChild(this.createRect(x, y, width, height, {
                'fill': 'none',
                'stroke': color,
                'stroke-width': '2',
                'stroke-dasharray': '6,3'
            }));
            
            // Show dimensions preview
            if (window.Measurements) {
                const dims = window.Measurements.rectangleDimensions(points[0], points[1]);
                
                // Width
                const widthLabel = this.createMeasurementLabel(
                    x + width / 2, y - 5,
                    `${dims.width.toFixed(1)}px`, color
                );
                widthLabel.classList.add('preview-measurement');
                this.measurementLayer.appendChild(widthLabel);
                
                // Height
                const heightLabel = this.createMeasurementLabel(
                    x + width + 10, y + height / 2,
                    `${dims.height.toFixed(1)}px`, color
                );
                heightLabel.style.transform = 'translate(0, -50%)';
                heightLabel.classList.add('preview-measurement');
                this.measurementLayer.appendChild(heightLabel);
            }
        }
    },
    
    /**
     * Render angle preview
     */
    renderAnglePreview(group, points, color) {
        if (points.length < 1) return;
        
        // First point (will become point1)
        const p1 = this.toDisplay(points[0].x, points[0].y);
        group.appendChild(this.createCircle(p1.x, p1.y, 4, {
            'fill': color
        }));
        
        if (points.length >= 2) {
            // Second point (vertex)
            const vertex = this.toDisplay(points[1].x, points[1].y);
            group.appendChild(this.createCircle(vertex.x, vertex.y, 5, {
                'fill': color
            }));
            group.appendChild(this.createLine(vertex.x, vertex.y, p1.x, p1.y, {
                'stroke': color,
                'stroke-width': '2',
                'stroke-dasharray': '6,3'
            }));
        }
        
        if (points.length >= 3) {
            // Third point (point2)
            const vertex = this.toDisplay(points[1].x, points[1].y);
            const p2 = this.toDisplay(points[2].x, points[2].y);
            
            group.appendChild(this.createCircle(p2.x, p2.y, 4, {
                'fill': color
            }));
            group.appendChild(this.createLine(vertex.x, vertex.y, p2.x, p2.y, {
                'stroke': color,
                'stroke-width': '2',
                'stroke-dasharray': '6,3'
            }));
            
            // Show angle preview
            if (window.Measurements) {
                const angle = window.Measurements.angle(points[0], points[1], points[2]);
                const label = this.createMeasurementLabel(
                    vertex.x + 25, vertex.y - 25,
                    `${angle.toFixed(1)}°`, color
                );
                label.classList.add('preview-measurement');
                this.measurementLayer.appendChild(label);
            }
        }
    },
    
    /**
     * Render polygon preview
     */
    renderPolygonPreview(group, points, color) {
        if (points.length < 1) return;
        
        const displayPoints = points.map(p => this.toDisplay(p.x, p.y));
        
        // Draw lines between points
        for (let i = 0; i < displayPoints.length - 1; i++) {
            group.appendChild(this.createLine(
                displayPoints[i].x, displayPoints[i].y,
                displayPoints[i + 1].x, displayPoints[i + 1].y,
                {
                    'stroke': color,
                    'stroke-width': '2',
                    'stroke-dasharray': '6,3'
                }
            ));
        }
        
        // Close polygon preview if 3+ points
        if (displayPoints.length >= 3) {
            group.appendChild(this.createLine(
                displayPoints[displayPoints.length - 1].x,
                displayPoints[displayPoints.length - 1].y,
                displayPoints[0].x, displayPoints[0].y,
                {
                    'stroke': color,
                    'stroke-width': '1',
                    'stroke-dasharray': '3,3',
                    'opacity': '0.5'
                }
            ));
        }
        
        // Draw vertex markers
        displayPoints.forEach((p, index) => {
            const isFirst = index === 0;
            group.appendChild(this.createCircle(p.x, p.y, isFirst ? 6 : 4, {
                'fill': isFirst ? color : 'white',
                'stroke': color,
                'stroke-width': '2'
            }));
        });
        
        // Show vertex count
        const label = this.createMeasurementLabel(
            displayPoints[0].x + 15, displayPoints[0].y - 10,
            `${points.length} points (double-click to finish)`, color
        );
        label.classList.add('preview-measurement');
        label.style.whiteSpace = 'nowrap';
        this.measurementLayer.appendChild(label);
    },
    
    /**
     * Render freehand preview
     */
    renderFreehandPreview(group, points, color) {
        if (points.length < 2) return;
        
        const displayPoints = points.map(p => this.toDisplay(p.x, p.y));
        
        // Create path
        let pathData = `M ${displayPoints[0].x} ${displayPoints[0].y}`;
        for (let i = 1; i < displayPoints.length; i++) {
            pathData += ` L ${displayPoints[i].x} ${displayPoints[i].y}`;
        }
        
        group.appendChild(this.createPath(pathData, {
            'fill': 'none',
            'stroke': color,
            'stroke-width': '2',
            'stroke-linecap': 'round',
            'stroke-linejoin': 'round'
        }));
        
        // Start marker
        group.appendChild(this.createCircle(displayPoints[0].x, displayPoints[0].y, 4, {
            'fill': color
        }));
    },
    
    // ========================================================================
    // Utility Methods
    // ========================================================================
    
    /**
     * Update renderer configuration
     * @param {Object} options - Configuration options to update
     */
    setConfig(options) {
        Object.assign(this.config, options);
    },
    
    /**
     * Enable/disable measurement display
     * @param {boolean} show - Whether to show measurements
     */
    setShowMeasurements(show) {
        this.config.showMeasurements = show;
        this.render();
    },
    
    /**
     * Enable/disable handle display
     * @param {boolean} show - Whether to show handles
     */
    setShowHandles(show) {
        this.config.showHandles = show;
        this.render();
    },
    
    /**
     * Destroy the renderer and clean up
     */
    destroy() {
        if (this.svg) {
            this.svg.remove();
            this.svg = null;
        }
        if (this.measurementLayer) {
            this.measurementLayer.remove();
            this.measurementLayer = null;
        }
        this.container = null;
        this.defs = null;
    }
};

// ============================================================================
// Export to Global Scope
// ============================================================================

if (typeof window !== 'undefined') {
    window.AnnotationRenderer = AnnotationRenderer;
}
